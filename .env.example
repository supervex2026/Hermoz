# Hermoz does NOT read API keys from this file at runtime - it's here only
# as a reference for what you'll be asked to paste into Settings the first
# time you run the app. Real keys are stored in your OS's secure credential
# store (Windows Credential Manager), never in a file, never in git.
#
# Get a Groq key:       https://console.groq.com/keys
# Get an OpenRouter key: https://openrouter.ai/keys

GROQ_API_KEY=
OPENROUTER_API_KEY=
